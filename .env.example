# MYSTI Phase 0 configuration template.
# Copy to `.env` and fill in values. NEVER commit `.env`.

# --- Storage ---
# local | s3 (s3 covers AWS S3, Backblaze B2, Cloudflare R2, MinIO)
MYSTI_STORAGE_PROVIDER=local
MYSTI_STORAGE_BUCKET=mysti
MYSTI_STORAGE_ENDPOINT=
MYSTI_STORAGE_REGION=
MYSTI_STORAGE_ACCESS_KEY=
MYSTI_STORAGE_SECRET_KEY=

# --- Cache ---
MYSTI_CACHE_MAX_MB=256
MYSTI_CACHE_TTL=86400

# --- Limits ---
MYSTI_MAX_RECORD_KB=1024

# --- Paths / logging ---
MYSTI_DATA_DIR=
MYSTI_LOG_LEVEL=INFO

# --- API ---
MYSTI_API_HOST=127.0.0.1
MYSTI_API_PORT=8000
MYSTI_API_TOKEN=

# --- Key management ---
# keyring (OS keystore, default) | file (opt-in fallback, less secure) | memory (TESTS ONLY)
MYSTI_SECRET_BACKEND=keyring
MYSTI_KEYRING_SERVICE=mysti
MYSTI_ALLOW_KEY_FILE_FALLBACK=false
MYSTI_KEY_FILE_PASSPHRASE=

# --- LLM ---
# none | openai | anthropic | ollama
MYSTI_LLM_PROVIDER=none
MYSTI_LLM_MODEL=
MYSTI_LLM_API_KEY=
MYSTI_LLM_BASE_URL=
